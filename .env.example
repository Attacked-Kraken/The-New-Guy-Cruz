# xAI / Grok (required)
XAI_API_KEY=your_xai_api_key_here
XAI_MODEL=grok-4.7
# Vision (images): preferred grok-4.6; falls back to grok-2-vision-1212 then text-only
XAI_VISION_MODEL=grok-4.6
# Optional snappy model used when /fast is on (text-only). Falls back to XAI_MODEL if unavailable.
# XAI_FAST_MODEL=grok-4.20
# XAI_BASE_URL=https://api.x.ai/v1

# Chat behavior
TEMPERATURE=0.7
MAX_HISTORY=20

# Telegram (required for telegram_bot.py)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather
# Optional allowlist: comma-separated chat IDs. Empty = allow anyone who DMs the bot.
TELEGRAM_CHAT_ID=

# SMS / Twilio (optional — only for sms_bot.py)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SMS_TO_NUMBER=

# Feature flags
# NEWGUY_TOOLS=1 enables web_search tool path on Deep / Auto→deep turns (default on)
NEWGUY_TOOLS=1

# Optional xAI management API (for /balance prepaid credits)
# XAI_MANAGEMENT_KEY=
# XAI_TEAM_ID=

# Optional deep model override
# XAI_DEEP_MODEL=grok-4.7

# Email stub (optional — no-op until configured)
# BACKUP_EMAIL_TO=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=

